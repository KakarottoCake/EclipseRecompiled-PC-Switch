diff --git a/module-template/CMakeLists.txt b/module-template/CMakeLists.txt
--- a/module-template/CMakeLists.txt
+++ b/module-template/CMakeLists.txt
@@ -40,11 +40,17 @@ set(MODULE_NAME "g${GAME_ID}_recomp")
 find_package(Python3 REQUIRED COMPONENTS Interpreter)
 
 set(MODULE_TABLES "${CMAKE_CURRENT_BINARY_DIR}/module_tables.inc")
+set(RECOMPCORE_MUTABLE_CHUNKS "" CACHE STRING
+    "Comma-separated guest chunk starts whose runtime hash is not compared")
+set(MODULE_TABLE_MUTABLE_ARG "")
+if(RECOMPCORE_MUTABLE_CHUNKS)
+  set(MODULE_TABLE_MUTABLE_ARG "${RECOMPCORE_MUTABLE_CHUNKS}")
+endif()
 add_custom_command(
   OUTPUT "${MODULE_TABLES}"
   COMMAND Python3::Interpreter "${CMAKE_CURRENT_SOURCE_DIR}/gen_module_tables.py"
           "${GENERATED_DIR}/generated.h" "${GENERATED_DIR}/generated_smc.txt"
-          "${GENERATED_DIR}/main.dol" "${MODULE_TABLES}"
+          "${GENERATED_DIR}/main.dol" "${MODULE_TABLES}" "${MODULE_TABLE_MUTABLE_ARG}"
   DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/gen_module_tables.py"
           "${GENERATED_DIR}/generated.h" "${GENERATED_DIR}/generated_smc.txt"
           "${GENERATED_DIR}/main.dol"
diff --git a/module-template/gen_module_tables.py b/module-template/gen_module_tables.py
--- a/module-template/gen_module_tables.py
+++ b/module-template/gen_module_tables.py
@@ -53,5 +53,9 @@ def main() -> int:
     smc_txt = Path(sys.argv[2])
     dol_path = Path(sys.argv[3])
     out_path = Path(sys.argv[4])
+    mutable_chunk_starts = set()
+    if len(sys.argv) >= 6 and sys.argv[5]:
+        for value in sys.argv[5].split(","):
+            mutable_chunk_starts.add(int(value, 0))
 
     header = generated_h.read_text()
@@ -129,5 +133,9 @@ def main() -> int:
         read_range = load_dol_text(dol_path)
         f.write("static const u64 s_chunk_hashes[] = {\n")
         for a, b in chunk_ranges:
-            f.write(f"    0x{fnv1a64(read_range(a, b)):016X}u,\n")
+            # A zero hash means the runtime value is intentionally not
+            # compared. This is reserved for chunks that combine executable
+            # code with writable loader tables or other mutable data.
+            value = 0 if a in mutable_chunk_starts else fnv1a64(read_range(a, b))
+            f.write(f"    0x{value:016X}u,\n")
         f.write("};\n")
