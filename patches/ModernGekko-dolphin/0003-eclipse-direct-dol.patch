-                     if (!device->UseDelayedTransferCompletion())
+                     // Immediate transfers complete as soon as the device has
+                     // consumed the command. Devices only delay DMA completion
+                     // when they model transfer-rate timing.
+                     if (m_control.DMA == 0 || !device->UseDelayedTransferCompletion())
                        SendTransferComplete();
