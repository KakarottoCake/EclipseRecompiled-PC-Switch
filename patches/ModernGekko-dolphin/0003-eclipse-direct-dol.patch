diff --git a/Source/Core/Core/Boot/Boot.cpp b/Source/Core/Core/Boot/Boot.cpp
index d44b63884e..850cdb7 100644
--- a/Source/Core/Core/Boot/Boot.cpp
+++ b/Source/Core/Core/Boot/Boot.cpp
@@ -282,14 +282,25 @@ bool CBoot::BootUp(Core::System& system, const Core::CPUThreadGuard& guard,
       return true;
     }

-    bool operator()(const BootParameters::Executable& executable) const
+    bool operator()(BootParameters::Executable& executable) const
     {
       NOTICE_LOG_FMT(BOOT, "Booting from executable: {}", executable.path);

       if (!executable.reader->IsValid())
         return false;

-      SetDefaultDisc(system.GetDVDInterface());
+      const DiscIO::VolumeDisc* volume = nullptr;
+      if (executable.disc)
+      {
+        volume = SetDisc(system.GetDVDInterface(), std::move(executable.disc->volume),
+                          std::move(executable.disc->auto_disc_change_paths));
+        if (!volume)
+          return false;
+      }
+      else
+      {
+        SetDefaultDisc(system.GetDVDInterface());
+      }

       auto& ppc_state = system.GetPPCState();

@@ -327,7 +338,56 @@ bool CBoot::BootUp(Core::System& system, const Core::CPUThreadGuard& guard,
         return false;
       }

-      AchievementManager::GetInstance().LoadGame(nullptr);
+      if (executable.disc)
+      {
+        // A normal GameCube boot reads the disc ID before any game code uses
+        // the DVD interface. Direct DOL boot skips the apploader, so perform
+        // that transition explicitly as well as copying the boot records.
+        if (!DVDReadDiscID(system, *volume, 0x00000000))
+        {
+          PanicAlertFmtT("Failed to read the extracted disc ID.");
+          return false;
+        }
+
+        // A normal GameCube bootloader copies the disc ID and filesystem table
+        // into low memory before transferring control to the DOL. A direct DOL
+        // boot skips that loader, so provide the same two boot records from the
+        // extracted volume before the game's DVD library initializes.
+        constexpr u32 fst_address = 0x817E0000;
+        std::vector<u8> boot_header(0x440);
+        std::vector<u8> fst;
+        if (!volume->Read(0, boot_header.size(), boot_header.data(), DiscIO::PARTITION_NONE))
+        {
+          PanicAlertFmtT("Failed to read the extracted disc filesystem table.");
+          return false;
+        }
+        const u32 fst_offset = Common::swap32(boot_header.data() + 0x424);
+        const u32 fst_size = Common::swap32(boot_header.data() + 0x428);
+        if (fst_size == 0 || fst_size > 0x00010000)
+        {
+          PanicAlertFmtT("The extracted disc has an invalid filesystem table size.");
+          return false;
+        }
+        fst.resize(fst_size);
+        if (!volume->Read(fst_offset, fst.size(), fst.data(), DiscIO::PARTITION_NONE))
+        {
+          PanicAlertFmtT("Failed to read the extracted disc filesystem table.");
+          return false;
+        }
+        auto& memory = system.GetMemory();
+        memory.CopyToEmu(0x80000000, boot_header.data(), 0x20);
+        memory.CopyToEmu(fst_address, fst.data(), fst.size());
+        memory.Write_U32(fst_address, 0x80000038);
+        memory.Write_U32(static_cast<u32>(fst.size()), 0x8000003C);
+
+        // Normal disc boot spends time in the IPL/apploader before the game
+        // first probes the EXI bus. Direct executable boot does not, so make
+        // the SDK's probe timer start in the ready state for the already
+        // attached emulated memory card.
+        system.GetExpansionInterface().PrepareForDirectBoot();
+      }
+
+      AchievementManager::GetInstance().LoadGame(volume);

       SConfig::OnTitleDirectlyBooted(guard);

