+
+void CEXIChannel::PrepareForDirectBoot()
+{
+  // The SDK's EXI probe treats an insertion interrupt as a 300 ms debounce
+  // window. A direct DOL starts after the IPL/apploader, so there is no
+  // hardware transition to wait through; report the already-present device
+  // without the stale insertion interrupt.
+  m_status.EXTINT = 0;
+  m_direct_boot_prepared = true;
+}
 }  // namespace ExpansionInterface
